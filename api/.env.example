APP_NAME="SaaS Starter"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin of the Nuxt frontend; the only origin allowed by CORS (config/cors.php)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Parallel requests for `php artisan serve` (needs --no-reload). A streamed AI answer holds a
# worker until it finishes, so with one worker the API stops answering while it streams.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=saas_starter
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# AI layer (config/ai.php). All AI calls run in Laravel; never expose the key to Nuxt.
# AI_PROVIDER: "anthropic" (Claude Messages API) or "fake" (canned responses, no network).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model for all AI features, e.g. claude-haiku-5-5 (cheapest), claude-sonnet-5-5, claude-opus-5-5.
AI_MODEL=claude-haiku-5-5
# Seconds per API call (keep below the job timeout of 75s).
AI_TIMEOUT=60
# Seconds for a streamed answer (writing help, chat), from the request to the last token.
AI_STREAM_TIMEOUT=120
# Refusal fallback: empty (off) or "default". Only works with Opus 5.5 / Sonnet 5.5, not Haiku.
AI_FALLBACKS=
# AI requests per organization per minute.
AI_RATE_LIMIT_PER_MINUTE=5
# Monthly AI budget per organization on the Free plan, in USD (owners can lower theirs; 0 turns AI off).
AI_MONTHLY_BUDGET_USD=5

# Billing (config/billing.php, Laravel Cashier). Payments happen on Stripe's hosted pages.
# BILLING_PROVIDER: "stripe" or "fake" (no network; checkout goes straight back to the billing page).
BILLING_PROVIDER=stripe
# Stripe API keys (Dashboard > Developers > API keys). Use test-mode keys locally. Never expose the secret to Nuxt.
STRIPE_KEY=
STRIPE_SECRET=
# Signing secret of the webhook endpoint (POST /api/stripe/webhook), or the one `stripe listen` prints.
# Required: without it every webhook is refused.
STRIPE_WEBHOOK_SECRET=
# Stripe price id (price_...) of the recurring Pro price.
STRIPE_PRICE_PRO=
# Pro price as shown in the app (Stripe charges the price's own amount) and its monthly AI budget in USD.
BILLING_PRO_DISPLAY_PRICE='$19 / month'
BILLING_PRO_AI_BUDGET_USD=50
# Stripe price id (price_...) of the one-time "$10 of AI credits" price, and its price as shown in the app.
# Credits add to the AI budget for the rest of the UTC month they're bought in.
STRIPE_PRICE_CREDITS_10=
BILLING_CREDITS_10_DISPLAY_PRICE='$10'
# Currency for Cashier (lowercase ISO code).
CASHIER_CURRENCY=usd

# Days to keep audit log entries (pruned daily by the scheduler). 0 keeps them forever.
AUDIT_RETENTION_DAYS=365

# Platform admin routes need a token that passed a two-factor code within this many minutes.
ADMIN_TWO_FACTOR_TTL_MINUTES=720
# Admin actions (suspend a user, reset their two-factor, ...) need a code within this many minutes.
ADMIN_ACTION_TWO_FACTOR_TTL_MINUTES=15

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Invitations, email verification and password reset links. "log" writes them to
# storage/logs/laravel.log (sent by the queue worker); use smtp etc. in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@saas-starter.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
